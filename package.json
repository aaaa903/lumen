{
  "name": "lumen",
  "version": "0.4.0",
  "private": true,
  "description": "本地优先的阅读、标注与知识库桌面应用",
  "author": "TXY",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "build": "electron-vite build",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "samples": "node scripts/make-sample-library.mjs",
    "probe:fts": "electron scripts/probe-fts.cjs",
    "db:inspect": "electron scripts/db-inspect.cjs",
    "icon": "node scripts/make-icon.mjs",
    "collect": "node scripts/collect-desktop.mjs",
    "pack:dir": "npm run build && npm run icon && electron-builder --dir",
    "pack": "npm run build && npm run icon && electron-builder --win --publish never && npm run collect",
    "pack:portable": "npm run build && npm run icon && electron-builder --win zip --publish never && npm run collect",
    "site:build": "node site/build.mjs",
    "release:assets": "node scripts/release-assets.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "iconv-lite": "^0.6.3",
    "pdfjs-dist": "^5.7.284",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.lumen.reader",
    "productName": "Lumen",
    "directories": {
      "output": "../lumen-next-desktop-build",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Lumen-${version}-portable.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "Lumen-${version}-setup.${ext}"
    }
  }
}
